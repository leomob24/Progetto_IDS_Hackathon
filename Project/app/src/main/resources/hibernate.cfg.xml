<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>

    <session-factory>
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>

        <property name="connection.url">jdbc:h2:file:./database/db;DB_CLOSE_DELAY=-1</property>
        <property name="connection.username">sa</property>
        <property name="connection.password"></property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property>

        <mapping class="org.example.Model.Hackathon"/>
        <mapping class="org.example.Model.Staff"/>
        <mapping class="org.example.Model.RuoloStaff"/>
        <mapping class="org.example.Model.Organizzatore"/>
        <mapping class="org.example.Model.Giudice"/>
        <mapping class="org.example.Model.Mentore"/>
        <mapping class="org.example.Model.Team"/>
        <mapping class="org.example.Model.Utente"/>
        <mapping class="org.example.Model.Invito"/>
        <mapping class="org.example.Model.Iscrizione"/>
        <mapping class="org.example.Model.Sottomissione"/>
        <mapping class="org.example.Model.Segnalazione"/>
        <mapping class="org.example.Model.Valutazione"/>
        <mapping class="org.example.Model.RichiestaDiSupporto"/>
        <mapping class="org.example.Model.Call"/>


    </session-factory>
</hibernate-configuration>